rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 訂單資料：允許已驗證用戶建立、讀取、更新狀態與刪除測試單
    match /artifacts/{appId}/public/data/orders/{orderId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 2. 餐點售完庫存設定：允許讀取與店家後台切換
    match /artifacts/{appId}/public/data/settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // 3. 【總部最高機密授權資料】所有店家僅能「讀取」自己的狀態；
    // 只有攜帶總部專屬簽章密鑰的請求才能「新增或修改」開關與到期日，外部工程師完全無法竄改！
    match /artifacts/{appId}/public/data/hq_stores/{storeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.hqSecretKey == "XINYUE_HQ_MASTER_SIG_2026_998877";
      allow delete: if false; // 禁止從前端刪除任何店家授權紀錄
    }
  }
}
