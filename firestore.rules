rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 訂單資料：允許已驗證用戶建立、讀取、更新狀態與刪除測試單
    match /artifacts/{appId}/public/data/orders/{orderId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 2. 餐點售完、菜單、店舖設定：允許讀取與店家後台儲存
    match /artifacts/{appId}/public/data/settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // 3. 總部授權資料：店家只能讀取；只有總部管理員 UID 能新增或修改
    match /artifacts/{appId}/public/data/hq_stores/{storeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == "PaQjiVn6dZdxe43kOJL2NuTyHKM2";
      allow delete: if false;
    }

    // 4. 全域安全設定（超級管理員救援密碼雜湊）：店家端需讀取才能驗證登入，
    //    因此允許已驗證用戶讀取；寫入僅限總部管理員 UID。
    match /artifacts/{appId}/public/data/hq_config/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == "PaQjiVn6dZdxe43kOJL2NuTyHKM2";
      allow delete: if false;
    }
  }
}
